# Existing Max credentials; supply values through private environment settings.
DISCORD_TOKEN=replace-with-test-bot-token
GITHUB_TOKEN=replace-with-test-repository-token
MAX_APPROVER_DISCORD_IDS=replace-with-your-discord-user-id
# Owners of Composio connections, external actions, memory admin and inference diagnostics.
# If absent, MAX_APPROVER_DISCORD_IDS is used for these owner commands.
MAX_OWNER_DISCORD_IDS=replace-with-your-discord-user-id
MAX_GITHUB_ALLOWED_USER_IDS=replace-with-your-discord-user-id
MAX_INFERENCE_PROVIDER=local
# NVIDIA is opt-in; leave MAX_INFERENCE_PROVIDER=local on production until tested.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MAX_INFERENCE_POLICY=local_only
MAX_OLLAMA_BASE_URL=http://127.0.0.1:11434
# For Railway-hosted FreeLLM, set MAX_INFERENCE_PROVIDER=freellm and
# MAX_INFERENCE_POLICY=cloud_allowed. Keep your deployed AI_BASE_URL and
# AI_MODEL=auto; do not copy a public gateway URL from another installation.
# Optional auto mode tries Ollama first. Cloud fallback requires all three:
# MAX_INFERENCE_PROVIDER=auto, MAX_AUTO_CLOUD_FALLBACK=true, and
# MAX_INFERENCE_POLICY=cloud_allowed, plus data-class permission if needed.
MAX_AUTO_CLOUD_FALLBACK=false
# Ordinary Discord chat has its own class. Enable only after approving chat
# content transfer to your Railway-hosted FreeLLM service.
MAX_ALLOW_CLOUD_CHAT=false
# Pasted private repository context needs separate, specific approval.
MAX_ALLOW_CLOUD_PRIVATE_REPO=false
# Repair prompts include source and memory; those need their own separate opt-ins.
MAX_ALLOW_CLOUD_SOURCE=false
MAX_ALLOW_CLOUD_MEMORY=false
AI_BASE_URL=
AI_API_KEY=
# For Railway-hosted FreeLLM set AI_MODEL=auto if that gateway supports it.
AI_MODEL=

# Phase 7 is disabled until the optional SDK and scoped policy are configured.
MAX_COMPOSIO_ENABLED=false
COMPOSIO_API_KEY=
MAX_COMPOSIO_POLICY_FILE=.max_state/composio-policy.json
# Optional explicit connection-only fallback when the private policy file is absent.
# Use the real GitHub AUTH CONFIG ID from the Composio dashboard. Zero actions
# and zero repo grants are enabled. If a policy file exists, it takes precedence.
MAX_COMPOSIO_GITHUB_AUTH_CONFIG_ID=
MAX_EXTERNAL_ACTIONS_DISABLED=true
MAX_MEMORY_DB=.max_state/memories.sqlite3
