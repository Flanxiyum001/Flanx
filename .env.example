# Existing Max credentials; supply values through private environment settings.
DISCORD_TOKEN=replace-with-test-bot-token
GITHUB_TOKEN=replace-with-test-repository-token
MAX_APPROVER_DISCORD_IDS=replace-with-your-discord-user-id
MAX_INFERENCE_PROVIDER=local
MAX_INFERENCE_POLICY=local_only
MAX_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional FreeLLM route; set both a key and explicit cloud privacy policy before use.
AI_BASE_URL=https://freellmapi.co/v1
AI_API_KEY=

# Phase 7 is disabled until the optional SDK and scoped policy are configured.
MAX_COMPOSIO_ENABLED=false
COMPOSIO_API_KEY=
MAX_COMPOSIO_POLICY_FILE=.max_state/composio-policy.json
MAX_EXTERNAL_ACTIONS_DISABLED=true
MAX_MEMORY_DB=.max_state/memories.sqlite3
